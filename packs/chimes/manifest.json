{
  "hail_version": "1.0",
  "name": "chimes",
  "display_name": "Chimes (Minimal)",
  "description": "Pleasant tones and chimes for each event category. Non-voice alternative.",
  "version": "1.0.0",
  "author": { "name": "team" },
  "categories": {
    "session.start": {
      "sounds": [
        { "file": "sounds/start-chime.mp3", "label": "Start chime" },
        { "file": "sounds/welcome-tone.mp3", "label": "Welcome tone" }
      ]
    },
    "task.acknowledge": {
      "sounds": [
        { "file": "sounds/ack-ping.mp3", "label": "Acknowledge ping" },
        { "file": "sounds/soft-tap.mp3", "label": "Soft tap" }
      ]
    },
    "task.complete": {
      "sounds": [
        { "file": "sounds/complete-chime.mp3", "label": "Complete chime" },
        { "file": "sounds/success-bell.mp3", "label": "Success bell" }
      ]
    },
    "task.error": {
      "sounds": [
        { "file": "sounds/error-buzz.mp3", "label": "Error buzz" },
        { "file": "sounds/warning-tone.mp3", "label": "Warning tone" }
      ]
    },
    "input.required": {
      "sounds": [
        { "file": "sounds/attention-ding.mp3", "label": "Attention ding" },
        { "file": "sounds/input-chime.mp3", "label": "Input chime" }
      ]
    },
    "resource.limit": {
      "sounds": [
        { "file": "sounds/limit-alert.mp3", "label": "Limit alert" }
      ]
    },
    "user.spam": {
      "sounds": [
        { "file": "sounds/slow-down.mp3", "label": "Slow down tone" }
      ]
    }
  }
}
